# ---------------------------------------------------------------------------
# ExpoFP
# ---------------------------------------------------------------------------
# Token from https://app.expofp.com/profile
EXPOFP_API_TOKEN=
EXPOFP_EXPO_ID=
# Set this once webhooks are registered, so deliveries are actually verified.
EXPOFP_WEBHOOK_SECRET=

# Routes from your copy of https://app.expofp.com/api-docs/json-api-v1.yaml.
# The service refuses to call an operation whose path is still unset.
EXPOFP_PATH_ADD_EXHIBITOR=
EXPOFP_PATH_ADD_EXHIBITOR_BOOTH=
EXPOFP_PATH_ADD_EXHIBITOR_EXTRA=
EXPOFP_PATH_SET_BOOTH_STATUS=
# Where the new exhibitor id sits in the Add Exhibitor response, dot separated.
EXPOFP_RESPONSE_EXHIBITOR_ID=exhibitorId

# ---------------------------------------------------------------------------
# PayPal
# ---------------------------------------------------------------------------
PAYPAL_ENV=sandbox
# Leave these empty to use the keys the client submitted through the
# storefront's Payment Gateway Setup section (GATEWAY_KEYS_URL below).
# Setting them here overrides that and keeps the secret out of the public store.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the PayPal developer dashboard, after creating the webhook.
PAYPAL_WEBHOOK_ID=

# Where the storefront section stores the client's chosen keys.
GATEWAY_KEYS_URL=https://6aa7e0369b08676cd32b9a36.mockapi.io/key

# ---------------------------------------------------------------------------
# Storefront
# ---------------------------------------------------------------------------
# Comma separated. Used for CORS and to validate the return URL.
ALLOWED_ORIGINS=https://collectivehub.com
# Fallback landing page when a return URL is missing or not allowed.
CHECKOUT_PAGE_URL=https://collectivehub.com/pages/booth-checkout

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
HOLD_MINUTES=30
RECORD_TTL_SECONDS=2592000
# Protects /api/cron/release-holds. Vercel Cron sends it automatically; an
# external scheduler (needed for a sub-daily cadence on the Hobby plan) must
# send it as "Authorization: Bearer <CRON_SECRET>". Use a long random string.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Storage (Vercel KV) - added automatically when you connect a KV store
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
