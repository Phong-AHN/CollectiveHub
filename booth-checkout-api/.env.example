# ---------------------------------------------------------------------------
# ExpoFP
# ---------------------------------------------------------------------------
# Token from https://app.expofp.com/profile
EXPOFP_API_TOKEN=
EXPOFP_EXPO_ID=36986
# The webhook secret from your ExpoFP profile, pasted exactly as shown -
# whsec_ prefix included. It is shown only once, when generated.
# During a rotation, list both secrets separated by a comma
# (new,old); drop the old one once deliveries verify against the new.
# Empty = signing not enabled: unsigned deliveries are accepted.
# Set = every delivery must carry a valid signature, or it gets 401 - so if
# you REMOVE the secret in ExpoFP, clear this too.
EXPOFP_WEBHOOK_SECRET=

# Every ExpoFP route and request body is built in from the JSON API reference.
# Nothing else to set here. (Should ExpoFP ever move a route, override it with
# EXPOFP_PATH_ADD_EXHIBITOR, EXPOFP_PATH_ADD_EXHIBITOR_BOOTH, EXPOFP_PATH_GET_BOOTH,
# EXPOFP_PATH_SET_BOOTH_STATUS, EXPOFP_PATH_LIST_BOOTHS or
# EXPOFP_PATH_GET_EXHIBITOR_ID. Do NOT set EXPOFP_RESPONSE_EXHIBITOR_ID: the
# default "id" is what add-exhibitor answers.)

# ---------------------------------------------------------------------------
# Which gateway
# ---------------------------------------------------------------------------
# Leave empty to use whatever the client last chose in the storefront's
# Payment Gateway Setup section. Set to "stripe" or "paypal" to force one.
PAYMENT_GATEWAY=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Secret key: sk_test_... while testing, sk_live_... for real payments.
# NOT the publishable key (pk_...). Empty = use the key from the setup section.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (Stripe Dashboard > Developers >
# Webhooks), starts with whsec_ - a different secret from ExpoFP's, even
# though both use that prefix. Comma-separate two during a rotation.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# PayPal
# ---------------------------------------------------------------------------
PAYPAL_ENV=sandbox
# Leave these empty to use the keys the client submitted through the
# storefront's Payment Gateway Setup section. Setting them here overrides that.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the PayPal developer dashboard, after creating the webhook.
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# Payment Gateway Setup section (the form the client pastes their keys into)
# ---------------------------------------------------------------------------
# Encrypts those keys before they are written to Redis (AES-256-GCM). Any long
# random string; generate one with:  openssl rand -base64 32
# Keep it: change it and the saved keys can no longer be read, and the client
# has to paste them again. Never commit it.
SECRETS_KEY=
# Optional. Set it and the form asks the client for this code before saving,
# which is what stops a stranger who finds the endpoint from pointing payments
# at their own account. Leave it empty and the form saves with no code - the
# field hides itself, and the endpoint is open to whoever finds it.
# Give it to the client privately; it is not in the theme.
SETUP_PASSCODE=

# ---------------------------------------------------------------------------
# Storefront
# ---------------------------------------------------------------------------
# Comma separated. Used for CORS and to validate the return URL.
ALLOWED_ORIGINS=https://collective-hub.myshopline.com
# Fallback landing page when a return URL is missing or not allowed.
CHECKOUT_PAGE_URL=https://collective-hub.myshopline.com/pages/booth-checkout

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Add-ons offered at checkout. Leave empty for the built-in catalogue
# (Power Plugs, $20, wall tables only). JSON array of
# { id, name, price, description, booths, expofpExtraId }; `booths` limits an
# add-on to those booth names, and an entry without one fits every booth.
BOOTH_EXTRAS=
# The booths Power Plugs can be run to, comma separated. Empty = the built-in
# list (5, 4, 3, 2, 29, 28, 27 - the tables with wall space).
POWER_PLUGS_BOOTHS=
# Currency shown on the add-on list before a booth's own currency is known.
DEFAULT_CURRENCY=USD
# Also record the add-ons on the ExpoFP exhibitor (needs extras that already
# exist on the expo, and its request body confirmed). Off unless set to 1.
EXPOFP_ASSIGN_EXTRAS=

HOLD_MINUTES=30
RECORD_TTL_SECONDS=2592000
# Protects /api/cron/release-holds. Vercel Cron sends it automatically; an
# external scheduler (needed for a sub-daily cadence on the Hobby plan) must
# send it as "Authorization: Bearer <CRON_SECRET>". Use a long random string.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Storage - REQUIRED on Vercel. Connect "Upstash for Redis" under the project's
# Storage tab and these are injected for you (either naming pair works:
# KV_REST_API_* or UPSTASH_REDIS_REST_*). Without it checkout/start answers
# 503 storage_not_configured. Set ALLOW_MEMORY_STORE=1 only for local tests.
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
